# LoyalPro backend — environment template
# Скопируйте в backend/.env и заполните значениями.
# .env в .gitignore — секреты не попадут в репозиторий.

# ── Runtime ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
TZ=Europe/Moscow
FRONTEND_URL=http://localhost:3001

# ── Database (Beget Postgres) ───────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/loyalpro_test
DB_SSL=true

# ── Telegram bot DB (separate Beget instance) ───────────────
BOT_DB_HOST=
BOT_DB_PORT=5432
BOT_DB_USER=
BOT_DB_PASSWORD=
BOT_DB_NAME=n8n_db

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET=change-me

# ── External APIs ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
SMS_RU_API_ID=

# ── S3 (patient photo cases — Yandex Object Storage / Selectel / Beget) ──
# Бакет должен быть приватным (Block Public Access on), SSE-S3 включено.
# Локально — отдельный бакет (например loyalpro-cases-dev), на проде — другой.
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=loyalpro-cases-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_URL_TTL_SECONDS=900
