# LoyalPro backend — environment template
# Скопируйте в backend/.env и заполните значениями.
# .env в .gitignore — секреты не попадут в репозиторий.

# ── Runtime ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
TZ=Europe/Moscow
FRONTEND_URL=http://localhost:3001
# Local nginx by default; set an explicit proxy address/CIDR for another topology.
TRUST_PROXY=loopback

# Shared registration and AI limits (PostgreSQL-backed).
REGISTER_IP_HOURLY_LIMIT=5
REGISTER_EMAIL_HOURLY_LIMIT=3
KB_RELAY_MINUTE_LIMIT=120
KB_ASK_USER_MINUTE_LIMIT=10
KB_ASK_SALON_MINUTE_LIMIT=30
KB_LLM_CONCURRENCY=2
KB_SALON_DAILY_CALLS=100
KB_SALON_MONTHLY_CALLS=2000
KB_GLOBAL_DAILY_CALLS=5000

# ── Database (Beget Postgres) ───────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/loyalpro_test
DB_SSL=true

# ── Telegram bot DB (separate Beget instance) ───────────────
BOT_DB_HOST=
BOT_DB_PORT=5432
BOT_DB_USER=
BOT_DB_PASSWORD=
BOT_DB_NAME=n8n_db

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET=change-me
# Mobile auth fails closed until both values are configured.
MOBILE_SALON_ID=
MOBILE_OTP_HASH_KEY=
MOBILE_OTP_REQUEST_LIMIT=5
MOBILE_OTP_REQUEST_WINDOW_MINUTES=15

# ── External APIs ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
SMS_RU_API_ID=

# ── S3 (patient photo cases — Yandex Object Storage / Selectel / Beget) ──
# Бакет должен быть приватным (Block Public Access on), SSE-S3 включено.
# Локально — отдельный бакет (например loyalpro-cases-dev), на проде — другой.
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=loyalpro-cases-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_URL_TTL_SECONDS=900
