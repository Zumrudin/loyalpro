{
  "expo": {
    "name": "PERI CLINIC",
    "slug": "clinic-app",
    "icon": "./assets/icon.png",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.peri.clinic",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocationWhenInUseUsageDescription": "Приложению нужен доступ к геолокации, чтобы построить маршрут до клиники."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.peri.clinic",
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Приложению нужен доступ к геолокации, чтобы построить маршрут до клиники.",
          "locationAlwaysAndWhenInUsePermission": "Приложению нужен доступ к геолокации, чтобы построить маршрут до клиники."
        }
      ]
    ],
    "scheme": "clinic-app",
    "owner": "clinic",
    "extra": {
      "eas": {
        "projectId": "237ab06c-cdcc-4b74-86e1-68c9e5a6d219"
      }
    }
  }
}
